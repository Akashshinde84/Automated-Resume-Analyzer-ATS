APP_NAME="Resume Analyzer API"
DEPLOYMENT_ENVIRONMENT=development
# Production Linux requires isolation, model and both secrets; see DEPLOYMENT.md.
ISOLATE_PARSING=false
PARSER_TIMEOUT_SECONDS=25
PARSER_MEMORY_MB=384
# JSON array; include each frontend origin explicitly (no trailing slash).
CORS_ORIGINS=["http://localhost:5173"]

# File size limit (10 MiB); total multipart request gets an additional 64 KiB.
MAX_UPLOAD_BYTES=10485760
MAX_DOCX_UNCOMPRESSED_BYTES=52428800
MAX_PDF_PAGES=200

# Install separately with: python -m spacy download en_core_web_sm
SPACY_MODEL=en_core_web_sm

# Skills/text weights must sum to 1. Importance values are strictly positive.
MATCHING_WEIGHTS={"skills":0.7,"text":0.3,"required_importance":2.0,"preferred_importance":1.0,"unspecified_importance":1.0}

# Default deployment mode: fail closed until a random token is set.
APP_MODE=single_user
SINGLE_USER_API_KEY=
SINGLE_USER_ID=primary
ALLOWED_HOSTS=["localhost","127.0.0.1"]
MAX_CONCURRENT_PROCESSING=2
REQUIRE_NER_MODEL=false

# No raw uploads are retained. Saving structured/text data requires store=true.
STORAGE_ENABLED=false
DATABASE_URL=
RETENTION_DAYS=7
RETENTION_CLEANUP_INTERVAL_SECONDS=3600
MAX_STORED_ANALYSES=1000
MAX_MATCHES_PER_ANALYSIS=50
# Signed stateless report snapshots expire after one hour. Bearer auth is required.
REPORT_TOKEN_TTL_SECONDS=3600
# Optional server-only random secret, at least 32 characters. Never give this to
# the browser. Set the same value across workers/replicas for portable receipts.
# Blank uses an ephemeral per-app key; restart invalidates stateless reports.
REPORT_SIGNING_KEY=
# PostgreSQL example (replace values locally; never commit credentials):
# DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/resume_analyzer
